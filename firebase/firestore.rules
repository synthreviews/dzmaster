rules_version = '2';

// DZMASTER — Firestore security rules
//
// IMPORTANT CONTEXT: the mastering tool itself (dzmaster.html) needs ZERO
// Firebase access — all audio processing happens locally in the visitor's
// browser. These rules only matter IF you choose to add the optional
// visit-counter snippet (see /firebase/README.md). If you never add that
// snippet, you don't need to deploy this file at all.
//
// Security model for this counter (why it's safe even though the Firebase
// config/API key is visible in your page source -- that is normal and
// expected for Firebase web apps; the API key is NOT a secret, these
// rules are the actual security boundary):
//
//   1. Exactly one document may ever be written to: counters/dzmaster_visits
//   2. Nobody can create or delete that document from the client -- it must
//      already exist (create it once yourself in the Firebase console).
//   3. Nobody can read it from the client -- only you, via the console.
//   4. The only allowed write is "increment `count` by exactly 1 and set
//      `lastUpdated` to now" -- nothing else can be changed, and no other
//      collection/document in the whole database is reachable at all.
//   5. Combined with Firebase App Check (see README) this also blocks
//      scripted/bot traffic from calling it outside a real browser session
//      that loaded your actual page.

service cloud.firestore {
  match /databases/{database}/documents {

    match /counters/dzmaster_visits {
      allow read:   if false; // visible to you only via the Firebase console
      allow create: if false; // pre-create this one document yourself, once
      allow delete: if false;

      allow update: if
        // only these two fields may change, nothing else
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'lastUpdated'])
        // count may only ever go up by exactly 1 per write
        && request.resource.data.count is int
        && request.resource.data.count == resource.data.count + 1
        // lastUpdated must be a real server timestamp, not client-supplied
        && request.resource.data.lastUpdated == request.time;
    }

    // "usage" holds the free-tier IP usage-limit counters written by the
    // checkMasteringUsage Cloud Function (see /firebase/functions). The
    // function uses the Admin SDK, which always bypasses these rules --
    // this block exists purely as defense-in-depth so that even a
    // misconfigured client SDK could never read or write this collection
    // directly. Document IDs are a salted hash of an IP address plus the
    // month, never the IP itself (see functions/index.js and the privacy
    // policy) -- there is nothing personally identifying to read here even
    // if this rule were ever loosened by mistake.
    match /usage/{document} {
      allow read, write: if false;
    }

    // Default-deny everything else in the project, including any
    // collection you might add later -- add a dedicated match block with
    // its own explicit rules rather than loosening this.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
